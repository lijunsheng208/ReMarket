# Local development only. Copy to .env before starting services.
COMPOSE_PROJECT_NAME=remarket
USER_GRPC_ADDR=127.0.0.1:50051
GATEWAY_HTTP_ADDR=127.0.0.1:8080
USER_GRPC_TARGET=127.0.0.1:50051
GATEWAY_RPC_TIMEOUT=3s
# Set a random secret of at least 32 bytes before using JWT. No default secret.
JWT_SECRET=
JWT_ISSUER=remarket
JWT_AUDIENCE=remarket-api
JWT_ACCESS_TTL=1h
USER_MYSQL_ADDR=127.0.0.1:3306
USER_MYSQL_USERNAME=remarket_user
USER_MYSQL_DATABASE=remarket_user
PRODUCT_GRPC_ADDR=127.0.0.1:50052
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=remarket_root_local
MYSQL_USER_PASSWORD=remarket_user_local
MYSQL_PRODUCT_PASSWORD=remarket_product_local
MYSQL_ORDER_PASSWORD=remarket_order_local
MYSQL_CHAT_PASSWORD=remarket_chat_local
REDIS_PORT=6379
REDIS_PASSWORD=remarket_redis_local
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=remarket
RABBITMQ_DEFAULT_PASS=remarket_rabbit_local
ELASTICSEARCH_PORT=9200
ES_JAVA_OPTS=-Xms512m -Xmx512m
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=remarket
MINIO_ROOT_PASSWORD=remarket_minio_local
