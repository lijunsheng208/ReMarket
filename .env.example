# Local development only. Copy to .env before starting services.
COMPOSE_PROJECT_NAME=remarket
USER_GRPC_ADDR=127.0.0.1:50051
GATEWAY_HTTP_ADDR=127.0.0.1:8080
USER_GRPC_TARGET=127.0.0.1:50051
PRODUCT_GRPC_TARGET=127.0.0.1:50052
ORDER_GRPC_TARGET=127.0.0.1:50053
GATEWAY_RPC_TIMEOUT=3s
# Set a random secret of at least 32 bytes before using JWT. No default secret.
JWT_SECRET=
JWT_ISSUER=remarket
JWT_AUDIENCE=remarket-api
JWT_ACCESS_TTL=1h
USER_MYSQL_ADDR=127.0.0.1:3306
USER_MYSQL_USERNAME=remarket_user
USER_MYSQL_DATABASE=remarket_user
# Independent random token (>=32 bytes); empty disables reservation RPC access.
# Share only between Order and Product. Never reuse JWT_SECRET.
ORDER_PRODUCT_SERVICE_TOKEN=
PRODUCT_GRPC_ADDR=127.0.0.1:50052
PRODUCT_MYSQL_ADDR=127.0.0.1:3306
PRODUCT_MYSQL_USERNAME=remarket_product
PRODUCT_MYSQL_DATABASE=remarket_product
ORDER_GRPC_ADDR=127.0.0.1:50053
ORDER_MYSQL_ADDR=127.0.0.1:3306
ORDER_MYSQL_USERNAME=remarket_order
ORDER_MYSQL_DATABASE=remarket_order
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=remarket_root_local
MYSQL_USER_PASSWORD=remarket_user_local
MYSQL_PRODUCT_PASSWORD=remarket_product_local
MYSQL_ORDER_PASSWORD=remarket_order_local
MYSQL_CHAT_PASSWORD=remarket_chat_local
REDIS_PORT=6379
REDIS_PASSWORD=remarket_redis_local
ELASTICSEARCH_PORT=9200
ES_JAVA_OPTS=-Xms512m -Xmx512m
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=remarket
MINIO_ROOT_PASSWORD=remarket_minio_local
KAFKA_PORT=9092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_CLIENT_ID=remarket
KAFKA_CONNECT_TIMEOUT=10s
KAFKA_TOPIC_PARTITIONS=3
KAFKA_RETENTION_MS=604800000
KAFKA_DLT_RETENTION_MS=2592000000
# REDIS_ADDR overrides 127.0.0.1:${REDIS_PORT}; container clients use redis:6379.
REDIS_ADDR=
REDIS_USERNAME=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=0
REDIS_DIAL_TIMEOUT=1s
REDIS_READ_TIMEOUT=200ms
REDIS_WRITE_TIMEOUT=200ms
REDIS_POOL_TIMEOUT=200ms
REDIS_CONNECT_TIMEOUT=2s
# Apply Product migration 000004 before running updated Product writes.
# Detail caching requires invalidation recovery.
PRODUCT_CACHE_INVALIDATION_ENABLED=false

PRODUCT_DETAIL_CACHE_ENABLED=false
# Enable Redis Lua limiting in Gateway; restart after changing rules.
GATEWAY_RATE_LIMIT_ENABLED=false
GATEWAY_RATE_LIMIT_TIMEOUT=100ms
GATEWAY_RATE_LIMIT_USER='{"capacity":20,"tokens":20,"interval":"1s"}'
GATEWAY_RATE_LIMIT_IP='{"capacity":40,"tokens":40,"interval":"1s"}'
GATEWAY_RATE_LIMIT_ROUTE='{"capacity":20,"tokens":20,"interval":"1s"}'
GATEWAY_RATE_LIMIT_ROUTES='{"POST /api/v1/auth/login":{"capacity":5,"tokens":5,"interval":"1m"},"POST /api/v1/auth/register":{"capacity":5,"tokens":5,"interval":"1m"},"POST /api/v1/orders":{"capacity":2,"tokens":2,"interval":"1s"}}'
