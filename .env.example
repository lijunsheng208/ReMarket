# Local development only. Copy to .env before starting services.
COMPOSE_PROJECT_NAME=remarket
USER_GRPC_ADDR=127.0.0.1:50051
GATEWAY_HTTP_ADDR=127.0.0.1:8080
USER_GRPC_TARGET=127.0.0.1:50051
PRODUCT_GRPC_TARGET=127.0.0.1:50052
ORDER_GRPC_TARGET=127.0.0.1:50053
GATEWAY_RPC_TIMEOUT=3s
# Set a random secret of at least 32 bytes before using JWT. No default secret.
JWT_SECRET=
JWT_ISSUER=remarket
JWT_AUDIENCE=remarket-api
JWT_ACCESS_TTL=1h
USER_MYSQL_ADDR=127.0.0.1:3306
USER_MYSQL_USERNAME=remarket_user
USER_MYSQL_DATABASE=remarket_user
# Independent random token (>=32 bytes); empty disables reservation RPC access.
# Share only between Order and Product. Never reuse JWT_SECRET.
ORDER_PRODUCT_SERVICE_TOKEN=
PRODUCT_GRPC_ADDR=127.0.0.1:50052
PRODUCT_MYSQL_ADDR=127.0.0.1:3306
PRODUCT_MYSQL_USERNAME=remarket_product
PRODUCT_MYSQL_DATABASE=remarket_product
ORDER_GRPC_ADDR=127.0.0.1:50053
ORDER_MYSQL_ADDR=127.0.0.1:3306
ORDER_MYSQL_USERNAME=remarket_order
ORDER_MYSQL_DATABASE=remarket_order
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=remarket_root_local
MYSQL_USER_PASSWORD=remarket_user_local
MYSQL_PRODUCT_PASSWORD=remarket_product_local
MYSQL_ORDER_PASSWORD=remarket_order_local
MYSQL_CHAT_PASSWORD=remarket_chat_local
REDIS_PORT=6379
REDIS_PASSWORD=remarket_redis_local
ELASTICSEARCH_PORT=9200
ES_JAVA_OPTS=-Xms512m -Xmx512m
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=remarket
MINIO_ROOT_PASSWORD=remarket_minio_local
KAFKA_PORT=9092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_CLIENT_ID=remarket
KAFKA_CONNECT_TIMEOUT=10s
KAFKA_TOPIC_PARTITIONS=3
KAFKA_RETENTION_MS=604800000
KAFKA_DLT_RETENTION_MS=2592000000
# REDIS_ADDR overrides 127.0.0.1:${REDIS_PORT}; container clients use redis:6379.
REDIS_ADDR=
REDIS_USERNAME=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=0
REDIS_DIAL_TIMEOUT=1s
REDIS_READ_TIMEOUT=200ms
REDIS_WRITE_TIMEOUT=200ms
REDIS_POOL_TIMEOUT=200ms
REDIS_CONNECT_TIMEOUT=2s
# Apply Product migration 000004 before running updated Product writes.
# Detail caching requires invalidation recovery.
PRODUCT_CACHE_INVALIDATION_ENABLED=false

PRODUCT_DETAIL_CACHE_ENABLED=false
# Enable Redis Lua limiting in Gateway; restart after changing rules.
GATEWAY_RATE_LIMIT_ENABLED=false
GATEWAY_RATE_LIMIT_TIMEOUT=100ms
GATEWAY_RATE_LIMIT_USER='{"capacity":20,"tokens":20,"interval":"1s"}'
GATEWAY_RATE_LIMIT_IP='{"capacity":40,"tokens":40,"interval":"1s"}'
GATEWAY_RATE_LIMIT_ROUTE='{"capacity":20,"tokens":20,"interval":"1s"}'
GATEWAY_RATE_LIMIT_ROUTES='{"POST /api/v1/auth/login":{"capacity":5,"tokens":5,"interval":"1m"},"POST /api/v1/auth/register":{"capacity":5,"tokens":5,"interval":"1m"},"POST /api/v1/orders":{"capacity":2,"tokens":2,"interval":"1s"}}'
# Go Topic mapping; Compose initialization uses the default names below.
KAFKA_PRODUCT_TOPIC=remarket.product.events.v1
KAFKA_ORDER_TOPIC=remarket.order.events.v1
KAFKA_PRODUCT_RETRY_TOPIC=remarket.product.events.retry.v1
KAFKA_ORDER_RETRY_TOPIC=remarket.order.events.retry.v1
KAFKA_PRODUCT_DLT_TOPIC=remarket.product.events.dlt.v1
KAFKA_ORDER_DLT_TOPIC=remarket.order.events.dlt.v1
# Each service publishes only from its own database. Disabled until explicitly enabled.
PRODUCT_OUTBOX_ENABLED=false
ORDER_OUTBOX_ENABLED=false
OUTBOX_CONCURRENCY=4
OUTBOX_POLL_INTERVAL=1s
OUTBOX_DB_TIMEOUT=3s
OUTBOX_PUBLISH_TIMEOUT=10s
OUTBOX_LEASE=30s
OUTBOX_RETRY_BASE=1s
OUTBOX_RETRY_MAX=1m
# Dedicated test-consumer database/account; provision and migrate explicitly.
EVENT_CONSUMER_AGGREGATE=product
EVENT_CONSUMER_GROUP=remarket.eventtest.product.v1
EVENT_CONSUMER_MYSQL_ADDR=127.0.0.1:3306
EVENT_CONSUMER_MYSQL_USERNAME=remarket_eventtest
EVENT_CONSUMER_MYSQL_DATABASE=remarket_eventtest
EVENT_CONSUMER_MYSQL_PASSWORD=
EVENT_CONSUMER_MAX_RETRIES=3
EVENT_CONSUMER_BACKOFF=1s

# Search：URL 为空时复用 ELASTICSEARCH_PORT；客户端会拒绝 OpenSearch 等错误实例。
ELASTICSEARCH_URL=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
SEARCH_GRPC_ADDR=127.0.0.1:50054
SEARCH_GRPC_TARGET=127.0.0.1:50054
SEARCH_WRITE_INDEX=products_v1
SEARCH_CONSUMER_GROUP=remarket-search-v1
# 自行生成至少 32 字节的专用值；不复用 JWT/Order 凭据，不提交真实密钥。
SEARCH_CURSOR_SECRET=
SEARCH_PRODUCT_EXPORT_TOKEN=
PRODUCT_WRITE_MAINTENANCE=false

# Feed 基础查询服务（无 Redis/Kafka 前置依赖）。
FEED_GRPC_ADDR=127.0.0.1:50055
FEED_GRPC_TARGET=127.0.0.1:50055
# 显式开启后 Feed 使用 Redis 混合时间线；关闭时保持 MySQL 基础查询。
FEED_REDIS_ENABLED=false
FEED_HOT_SELLER_THRESHOLD=1000
FEED_TIMELINE_LIMIT=1000
FEED_CONSUMER_GROUP=remarket-feed-v1
# User 与 Feed Consumer 共享的独立服务凭据，至少 32 字节，不得复用 JWT 密钥。
FEED_USER_SERVICE_TOKEN=

# 商品图片使用阿里云 OSS；先创建私有 Bucket 并配置浏览器直传 CORS。
OSS_IMAGES_ENABLED=false
OSS_REGION=
OSS_BUCKET=
# 可留空，SDK 按地域选择公网 HTTPS Endpoint；浏览器须能访问签名地址。
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SESSION_TOKEN=

# Chat 独立查询服务；需显式执行 migrations/chat 后启动。
CHAT_MYSQL_ADDR=127.0.0.1:3306
CHAT_MYSQL_USERNAME=remarket_chat
CHAT_MYSQL_DATABASE=remarket_chat
CHAT_GRPC_ADDR=127.0.0.1:50056
CHAT_GRPC_TARGET=127.0.0.1:50056
# WebSocket 浏览器 Origin 白名单（逗号分隔、无末尾斜杠）；同源默认允许。
CHAT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 显式开启 Chat 跨 Gateway 实例路由与通知；所有实例使用相同前缀和 Redis DB。
CHAT_REDIS_ENABLED=false
CHAT_REDIS_PREFIX=chat:
CHAT_ROUTE_TTL=30s
CHAT_ROUTE_RENEW_INTERVAL=10s
