{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Order events v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.:-]{1,128}$"
    },
    "event_type": {
      "enum": [
        "order.created.v1",
        "order.reserved.v1",
        "order.confirming.v1",
        "order.cancelling.v1",
        "order.expiring.v1",
        "order.completed.v1",
        "order.cancelled.v1",
        "order.expired.v1",
        "order.failed.v1"
      ]
    },
    "aggregate_type": {
      "const": "order"
    },
    "aggregate_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$",
      "description": "正数 int64 的十进制字符串，消费者须检查不超过 9223372036854775807"
    },
    "aggregate_version": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$",
      "description": "正数 int64 的十进制字符串，消费者须检查不超过 9223372036854775807"
    },
    "schema_version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "order_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "buyer_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "seller_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "product_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "price_cent": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "status": {
          "enum": [
            "PENDING",
            "RESERVED",
            "CONFIRMING",
            "CANCELLING",
            "EXPIRING",
            "COMPLETED",
            "CANCELLED",
            "EXPIRED",
            "FAILED"
          ]
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "buyer_confirmed": {
          "type": "boolean"
        },
        "seller_confirmed": {
          "type": "boolean"
        }
      },
      "required": [
        "order_id",
        "buyer_id",
        "seller_id",
        "product_id",
        "price_cent",
        "status",
        "expires_at",
        "buyer_confirmed",
        "seller_confirmed"
      ]
    }
  },
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "aggregate_version",
    "schema_version",
    "occurred_at",
    "data"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "order.created.v1"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "properties": {
              "status": {
                "const": "PENDING"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "order.reserved.v1"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "properties": {
              "status": {
                "const": "RESERVED"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "order.confirming.v1"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "properties": {
              "status": {
                "const": "CONFIRMING"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "order.cancelling.v1"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "properties": {
              "status": {
                "const": "CANCELLING"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "order.expiring.v1"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "properties": {
              "status": {
                "const": "EXPIRING"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "order.completed.v1"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "properties": {
              "status": {
                "const": "COMPLETED"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "order.cancelled.v1"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "properties": {
              "status": {
                "const": "CANCELLED"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "order.expired.v1"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "properties": {
              "status": {
                "const": "EXPIRED"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "order.failed.v1"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "properties": {
              "status": {
                "const": "FAILED"
              }
            }
          }
        }
      }
    }
  ]
}
